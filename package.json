{
  "name": "netwatch",
  "version": "2.0.0",
  "description": "Self-hosted Windows media client with a Docker/VPN-isolated runtime",
  "license": "GPL-3.0-only",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "vite",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "npm run package:win",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "package:dir": "npm run build:renderer && electron-builder --win --dir",
    "package:win": "npm run build:renderer && electron-builder --win nsis",
    "backend:unsafe-host-dev": "cd backend && uvicorn main:app --reload --port 8000"
  },
  "dependencies": {
    "@peculiar/x509": "^2.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "axios": "^1.20.0",
    "framer-motion": "^11.3.0",
    "iconoir-react": "^7.12.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^4.5.0",
    "concurrently": "^10.0.4",
    "electron": "^43.5.0",
    "electron-builder": "^26.15.7",
    "vite": "^8.1.5",
    "wait-on": "^9.1.0",
    "typescript": "7.0.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7"
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "4.1.3"
    },
    "concurrently": {
      "shell-quote": "1.12.0"
    },
    "source-map-js": "1.2.2"
  },
  "build": {
    "appId": "com.netwatch.desktop",
    "productName": "NetWatch",
    "beforePack": "packaging/verify-runtime.js",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/vite-worker.js",
      "remote-gateway/**/*",
      "shared/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/mpv",
        "to": "mpv",
        "filter": [
          "mpv.com",
          "mpv.exe",
          "*.dll",
          "portable_config/**/*",
          "README.md",
          "Copyright.txt",
          "LICENSE.GPL-2.0"
        ]
      },
      {
        "from": "resources/native",
        "to": "native",
        "filter": [
          "netwatch-surface-helper.exe",
          "README.md",
          "GO-LICENSE.txt"
        ]
      },
      {
        "from": "build/netwatch.ico",
        "to": "tray/netwatch.ico"
      },
      {
        "from": "backend",
        "to": "runtime-template/backend",
        "filter": [
          "*.py",
          "routes/*.py",
          "services/*.py",
          "Dockerfile",
          "requirements*.txt",
          ".dockerignore",
          ".env.example"
        ]
      },
      {
        "from": "torrent-engine",
        "to": "runtime-template/torrent-engine",
        "filter": [
          "*.py",
          "Dockerfile",
          "requirements*.txt",
          ".dockerignore"
        ]
      },
      {
        "from": "docker",
        "to": "runtime-template/docker",
        "filter": [
          "docker-compose.yml",
          "docker-compose.packaged.yml",
          "secure_config.py",
          "verify-networking.py",
          "verify-vpn-bootstrap.py",
          "torrent-engine/resolv.conf",
          "wireguard/wg_confs/wg0.conf.example"
        ]
      },
      {
        "from": "packaging/runtime-version.txt",
        "to": "runtime-template/.netwatch-runtime-version"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "DISCLAIMER.md",
        "to": "DISCLAIMER.md"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "executableName": "NetWatch",
      "icon": "build/netwatch.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "output": "release"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "artifactName": "NetWatch-Setup-${version}.${ext}",
      "installerIcon": "build/netwatch.ico",
      "uninstallerIcon": "build/netwatch.ico",
      "shortcutName": "NetWatch",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": true
    },
    "copyright": "Copyright © 2026 NetWatch contributors"
  },
  "engines": {
    "node": ">=22.12 <23"
  },
  "author": "NetWatch contributors"
}

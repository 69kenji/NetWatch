# Metadata / subtitle providers
TMDB_API_KEY=your_tmdb_api_key_here
OPENSUBTITLES_API_KEY=your_opensubtitles_key_here
SUBDL_API_KEY=your_subdl_key_here

# Local services (Compose overrides these to loopback inside the shared VPN namespace)
TORRENT_ENGINE_URL=http://localhost:8081
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=your_prowlarr_api_key_here
DEPENDENCY_TIMEOUT_SECS=4
PROWLARR_SEARCH_TIMEOUT_SECS=25

# Shared ephemeral torrent storage
TEMP_DOWNLOAD_DIR=/tmp/netwatch

# Internal FlareSolverr API. Prowlarr can use it as an indexer proxy.
# Compose overrides this to VPN-namespace loopback.
FLARESOLVERR_URL=http://127.0.0.1:8191

# Optional outside Compose. Packaged/development Compose provides a persistent cache path.
NETWATCH_CACHE_DIR=
